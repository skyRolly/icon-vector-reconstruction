# iteration snapshots: regenerate with tools/render.py / tools/compare.py
out/r[0-9]*.png
out/_*.png
__pycache__/
*.pyc
# resolution-sweep renders: regenerate with tools/validate.py
out/render_512.png
out/render_2048.png
out/render_4096.png
# intermediate numeric dumps from tools/isolate.py: 12 MB each, and one
# command regenerates them
out/*.npy
# the accepted-baseline render is regenerated by publish.sh from out/baseline/reconstruction.svg
out/baseline/render_1024.png
out/baseline/render_1024.png.prov.json
